# Arte in Oro — generato da strumenti/genera-seo.js
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
RewriteEngine On
# Un solo indirizzo per Google: HTTPS e www.arteinorovoghera.it
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.arteinorovoghera\.it$ [NC]
RewriteRule ^ https://www.arteinorovoghera.it%{REQUEST_URI} [L,R=301]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]
# Cartelle di lavoro non pubbliche
RewriteRule ^(strumenti|prove|node_modules|assets/img/originali)(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(webp|png|jpg|svg|ico|woff2|mp4)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
