# Materaxissimi & Co. — generato da strumenti/genera.js
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
RewriteEngine On
# Un solo indirizzo per Google: HTTPS e senza www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://materaxissimi.it%{REQUEST_URI} [L,R=301]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]
# Vecchi indirizzi del sito precedente -> nuove pagine
RewriteRule ^shop/?$ /materassi.html [L,R=301]
RewriteRule ^consultation/?$ /consulenza-materasso-a-domicilio.html [L,R=301]
RewriteRule ^about/?$ /chi-siamo.html [L,R=301]
RewriteRule ^contact/?$ /contatti.html [L,R=301]
RewriteRule ^privacy/?$ /privacy-policy.html [L,R=301]
RewriteRule ^terms/?$ /privacy-policy.html [L,R=301]
RewriteRule ^(strumenti|sorgenti|node_modules)(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(webp|png|jpg|svg|woff2|ico|mp4)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
