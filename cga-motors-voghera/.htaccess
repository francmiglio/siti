# CGA Motors - generato da strumenti/genera.js (solo caratteri ASCII)
# Nessun reindirizzamento di dominio o di protocollo: il sito funziona su qualsiasi dominio,
# compreso quello temporaneo di Hostinger, senza mai rimandare al sito vecchio. L'HTTPS si attiva dal pannello.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs

<IfModule mod_rewrite.c>
RewriteEngine On
# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]
# Vecchi indirizzi del sito WordPress -> nuove pagine
RewriteRule ^homepage/?$ / [L,R=301]
RewriteRule ^chi-siamo/?$ /chi-siamo.html [L,R=301]
RewriteRule ^contatti/?$ /contatti.html [L,R=301]
RewriteRule ^servizi/?$ /servizi.html [L,R=301]
RewriteRule ^promozione/?$ /promozioni.html [L,R=301]
RewriteRule ^officina/?$ /officina-riparazioni-auto.html [L,R=301]
RewriteRule ^servizi/centro-revisioni-autorizzato/?$ /revisione-auto-voghera.html [L,R=301]
RewriteRule ^servizi/tagliando-auto/?$ /tagliando-auto.html [L,R=301]
RewriteRule ^servizi/officina-autoriparazioni/?$ /officina-riparazioni-auto.html [L,R=301]
RewriteRule ^servizi/servizio-pneumatici/?$ /pneumatici-voghera.html [L,R=301]
RewriteRule ^vendita/?$ /auto-usate-voghera.html [L,R=301]
RewriteRule ^servizi/supporto-tecnico/?$ /verifica-auto-usata-prima-dell-acquisto.html [L,R=301]
RewriteRule ^noleggio/?$ /noleggio-auto-furgoni-voghera.html [L,R=301]
RewriteRule ^servizi/rimappatura/?$ /rimappatura-centraline.html [L,R=301]
RewriteRule ^servizi/installazione-dash-cam-a-360/?$ /installazione-dash-cam-360.html [L,R=301]
RewriteRule ^servizi/assicurazioni/?$ /assicurazioni-auto-voghera.html [L,R=301]
RewriteRule ^servizi/garanzie-supplementari/?$ /garanzia-auto-usate-fidelitycar.html [L,R=301]
RewriteRule ^officine/?$ /auto-d-epoca-e-rally.html [L,R=301]
RewriteRule ^noleggio/.+$ /noleggio-auto-furgoni-voghera.html [L,R=301]
RewriteRule ^(feed|comments/feed|wp-json)(/.*)?$ / [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(webp|png|jpg|svg|woff2|ico|mp4)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
