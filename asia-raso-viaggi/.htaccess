# ARound - generato da strumenti/genera.js (solo caratteri ASCII)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/octet-stream .bin
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Robots-Tag "noindex, nofollow"
<FilesMatch "\.(webp|png|jpg|svg|ico|woff2|bin)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
<FilesMatch "\.(html|txt)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/octet-stream
</IfModule>
